{
  "name": "Chris Comics Extensions",
  "private": true,
  "description": "Paperback extensions for Chris's comic sources.",
  "scripts": {
    "tsc": "tsc",
    "lint": "oxlint --type-aware --fix",
    "lint:check": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "conformance": "npm run tsc && npm run lint:check && npm run format:check",
    "bundle": "paperback bundle",
    "serve": "paperback serve",
    "dev": "paperback serve --watch",
    "logcat": "paperback logcat",
    "test": "paperback test",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@paperback/toolchain": "^0.8.7",
    "@paperback/types": "^0.8.7",
    "@types/chai": "^5.2.3",
    "chai": "^6.2.2",
    "cheerio": "^1.2.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^0.23.0",
    "patch-package": "^8.0.1",
    "typescript": "^6.0.3"
  },
  "baseURL": "https://chumpz0.github.io/PB-ext/0.9/stable",
  "repositoryName": "Chris Comics Extensions"
}
